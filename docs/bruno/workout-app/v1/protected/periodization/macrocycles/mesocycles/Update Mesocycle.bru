meta {
  name: Update Mesocycle
  type: http
  seq: 4
}

put {
  url: {{base_url}}api/v1/periodization/macrocycles/:macrocycle/mesocycles/:mesocycle
  body: json
  auth: inherit
}

body:json {
  {
    "mesocycle_type_id": 1,
    "split_type_id": 1,
    "order": 1,
    "start_week": 1,
    "duration_weeks": 6,
    "deload_weeks": [6],
    "notes": null
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
