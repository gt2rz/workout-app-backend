meta {
  name: Change Password
  type: http
  seq: 7
}

post {
  url: {{base_url}}api/v1/auth/password/change
  body: json
  auth: inherit
}

body:json {
  {
    "current_password": "12345678",
    "password": "NewPassword123",
    "password_confirmation": "NewPassword123"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
