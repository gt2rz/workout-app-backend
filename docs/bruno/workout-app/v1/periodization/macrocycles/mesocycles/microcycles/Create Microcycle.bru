meta {
  name: Create Microcycle
  type: http
  seq: 2
}

post {
  url: {{base_url}}api/v1/periodization/macrocycles/:macrocycle/mesocycles/:mesocycle/microcycles
  body: json
  auth: inherit
}

body:json {
  {
    "week_number": 1,
    "start_date": "2026-03-01",
    "end_date": "2026-03-07",
    "is_deload": false,
    "target_volume_percentage": 100,
    "status": "planned"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
